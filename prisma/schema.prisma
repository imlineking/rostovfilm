generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ContactRequest {
  id          String   @id @default(cuid())
  name        String
  contact     String
  projectType String?
  message     String?
  status      String   @default("new")
  createdAt   DateTime @default(now())
}
