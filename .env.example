# ==== Уведомления о заявках с сайта (скопируйте в .env.local и заполните) ====
# Скопировать:  cp .env.example .env.local
# После заполнения перезапустить dev-сервер.

# --- E-mail: письмо на внешний Яндекс-ящик (SMTP) ---
# Ящик-ОТПРАВИТЕЛЬ: ящик студии на Яндексе. Обычный пароль не подойдёт —
# создайте «пароль приложения»: id.yandex.ru → Безопасность → Пароли приложений → Почта.
STUDIO_SMTP_HOST=smtp.yandex.ru
STUDIO_SMTP_PORT=465
STUDIO_SMTP_USER=почта-студии@yandex.ru
STUDIO_SMTP_PASS=пароль-приложения
# Получатель (внешний Яндекс-ящик; можно несколько через запятую):
STUDIO_NOTIFY_EMAIL=внешний@yandex.ru
STUDIO_FROM_NAME=Сайт Ростовфильм

# --- Мессенджер MAX: сообщение от бота ---
# 1) На платформе MAX для партнёров (dev.max.ru) создайте бота — нужен
#    верифицированный профиль организации/ИП/самозанятого.
# 2) Скопируйте токен из раздела «Чат-боты».
# 3) Напишите боту первым (диалог должен быть начат) и узнайте chat_id:
#    bun scripts/max-check.mjs <ТОКЕН>
MAX_BOT_TOKEN=токен-бота-max
MAX_CHAT_ID=id-чата

# --- Капча формы заявки (собственная, без внешних сервисов) ---
# Случайная строка для подписи проверочных токенов. Сгенерировать:
#   openssl rand -hex 32
STUDIO_CAPTCHA_SECRET=случайная-строка

# --- Лимит заявок с одного IP ---
# Не больше STUDIO_RATE_LIMIT успешных заявок за STUDIO_RATE_WINDOW_MS миллисекунд
# (по умолчанию 3 за 10 минут). Лимит применяют только к заявкам, прошедшим капчу.
STUDIO_RATE_LIMIT=3
STUDIO_RATE_WINDOW_MS=600000

# Публичный адрес сайта (для подписи в письмах):
NEXT_PUBLIC_SITE_URL=https://rostovfilm.ru

# ВАЖНО: API MAX использует российский УЦ Минцифры. Запускайте сервер так:
#   NODE_EXTRA_CA_CERTS=certs/russian-trusted-ca.pem bun run dev
# (или sh scripts/start-dev.sh). Сертификаты уже в certs/russian-trusted-ca.pem.
